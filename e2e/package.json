{
  "name": "@codotech/playwright-e2e-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained demonstration suite for the Playwright E2E CI framework",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "check": "pnpm run test:static && pnpm run test",
    "install:browsers": "playwright install --with-deps chromium",
    "test": "playwright test",
    "test:ci": "CI=true playwright test",
    "test:debug": "playwright test --debug",
    "test:static": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.6.2",
    "playwright-ctrf-json-reporter": "0.0.29",
    "typescript": "6.0.3"
  }
}
